# development: 키가 없으면 AI 심사를 자동 승인 / production: 아래 필수값이 없으면 서버가 시작되지 않음
APP_ENV=development

# production 필수
JWT_SECRET_KEY=
OPENAI_API_KEY=
BASE_URL=http://localhost:8000
# 쉼표로 구분, production에서는 * 사용 불가 (예: https://your-frontend.example)
CORS_ORIGINS=*

# 선택
OPENAI_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///./memory_coordinates.db

# true면 소셜 토큰을 검증하지 않음. 로컬 개발 전용이며 production에서는 서버가 시작되지 않음
OAUTH_DEMO_MODE=false

# 개발 전용 미션 초기화 API(POST /api/v1/dev/missions/reset)용 토큰. 요청 헤더 X-Dev-Token으로 보냄
# 비워 두면 이 API는 404를 반환하고, APP_ENV=production이면 API 자체가 등록되지 않음. 실제 값은 .env에만 적고 커밋하지 말 것
DEV_RESET_TOKEN=
